APP_ENV=development
DATABASE_URL=sqlite:///./mangai_dev.db
POSTGRES_PASSWORD=change-me
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATA_MODE=demo
DATA_DIR=data
MODEL_DIR=models
LOG_LEVEL=INFO
VITE_API_BASE_URL=

# Required when DATA_MODE=live. Use the mine/site coordinates configured for the deployment.
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_TIMEOUT_SECONDS=10
WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast
WEATHER_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# Required for live Microsoft Planetary Computer Sentinel-2 scene discovery. These are the mine/site center coordinates.
SENTINEL2_LATITUDE=
SENTINEL2_LONGITUDE=
SENTINEL2_COLLECTION=sentinel-2-l2a
SENTINEL2_MAX_CLOUD_COVER=20
SENTINEL2_BBOX_DELTA=0.05
SENTINEL2_TIMEOUT_SECONDS=20

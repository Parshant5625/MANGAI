APP_ENV=development
DATABASE_URL=sqlite:///./mangai_dev.db
POSTGRES_PASSWORD=change-me
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATA_MODE=demo
DATA_DIR=data
MODEL_DIR=models
LOG_LEVEL=INFO
VITE_API_BASE_URL=

# Required when DATA_MODE=live. Use the mine/site coordinates configured for the deployment.
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_TIMEOUT_SECONDS=10
# Defaults use Open-Meteo public endpoints; override only for an approved compatible deployment.
WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast
WEATHER_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
